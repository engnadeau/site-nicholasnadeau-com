---
import { Image } from 'astro:assets';

import robotImage from '~/assets/images/hero/nicholas-robot.jpg';
import onixImage from '~/assets/images/hero/nicholas-david-onix.jpg';
---

<div class="flex flex-col gap-3">
  <Image
    src={robotImage}
    alt="Nicholas Nadeau next to a humanoid robot"
    widths={[400, 768, 1024, 1600]}
    sizes="(max-width: 1023px) 100vw, 50vw"
    loading="eager"
    fetchpriority="high"
    class="w-full aspect-[3/2] object-cover rounded-md"
  />
  <Image
    src={onixImage}
    alt="Nicholas Nadeau and David Bennahum, co-founders of Onix"
    widths={[400, 768, 1024, 1536]}
    sizes="(max-width: 1023px) 100vw, 50vw"
    loading="eager"
    class="w-full aspect-[5/2] object-cover object-[center_35%] rounded-md"
  />
</div>
