---
import Layout from '~/layouts/LandingLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Expert Consulting & Technical Due Diligence | Nicholas Nadeau, Ph.D., P.Eng.',
};
---

<Layout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->

  <Hero
    tagline="Technical Due Diligence"
    title="See the technical reality before you sign"
    subtitle="Technical due diligence on AI, data, and robotics companies, from a CTO who has built them."
    actions={[{ variant: 'primary', text: 'Message me on LinkedIn', href: 'https://www.linkedin.com/in/engnadeau/' }]}
    image={{
      src: '~/assets/images/landing/nicholas.jpg',
      alt: 'Consulting and due diligence for high-stakes decisions',
    }}
  />

  <!-- Call to Action Widget ******************* -->

  <CallToAction
    title="Diligence from a builder"
    subtitle="Ex-CTO of 1X and SmartOne.ai. Ph.D. in robotics. Nearly twenty years building AI, data, and robotics systems."
    actions={[
      {
        variant: 'primary',
        text: 'Message me on LinkedIn',
        href: 'https://www.linkedin.com/in/engnadeau/',
      },
    ]}
  />
</Layout>
