---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

import heroImage from '~/assets/images/hero-nicholas.jpg';

const metadata = {
  title: 'Nicholas Nadeau',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero2
    id="hero"
    title="Hey, I'm Nicholas"
    subtitle="Building ethical, decentralized AI. Humans, AI, and robots as one system. Co-founder and CTO, Onix. Ex-CTO, 1X."
    image={{
      src: heroImage,
      alt: 'Nicholas Nadeau',
    }}
  />
  <BlogLatestPosts id="posts" title="Latest Posts" />
</Layout>
